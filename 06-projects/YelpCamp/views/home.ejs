<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/stylesheets/home.css">

  <title>YelpCamp</title>
</head>

<body class="d-flex text-center align-items-center text-white bg-dark">
  <div class="cover-container d-flex min-vh-100 p-3 mx-auto flex-column">
    <header class="mb-auto">
      <div class="d-flex flex-column flex-md-row align-items-center pb-3">
        <h3 class="float-md-start mb-0">YelpCamp</h3>
        <nav class="nav nav-masthead justify-content-center ms-md-auto">
          <a class="nav-link active" aria-current="page" href="/">Home</a>
          <a class="nav-link" href="/campgrounds">Campgrounds</a>
          <div class="d-flex flex-md-row">
            <% if (!currentUser) { %>
            <a class="nav-link" href="/register">Register</a>
            <a class="nav-link" href="/login">Login</a>
            <% } else { %>
            <a class="nav-link" href="/logout">Logout</a>
            <% } %>
          </div>
        </nav>
      </div>
    </header>

    <main class="d-flex flex-grow-1 flex-column align-items-center justify-content-center px-3">
      <h1>YelpCamp</h1>
      <p class=" lead">
        Welcome to YelpCamp!<br>
        Explore and share campgrounds.<br>
        Leave comments on places you discover. </p>
      <a href="/campgrounds" class="w-auto btn btn-lg btn-secondary font-weight-bold w-fit">View Campgrounds</a>
    </main>

    <footer class="mt-auto text-white-50 pt-3">
      <p>&copy; <%= new Date().getFullYear() %> YelpCamp. All rights reserved.</p>
    </footer>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>